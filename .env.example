# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Client
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin / Server
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-4-5
# Set to false to switch off live HR advisor chat. High-risk cases still reach the advisor desk.
LIVE_ADVISOR_ENABLED=true
# Managers start a new HR chat after one closes. Set to true to let them reopen the closed one instead.
ADVISOR_ALLOW_REOPEN=false
ADVISOR_BUSINESS_TIMEZONE=America/New_York
ANTHROPIC_PROMPT_CACHE_TTL=5m
AI_MAX_OUTPUT_TOKENS=600
AI_RATE_LIMIT_MAX_REQUESTS=20
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RESPONSE_CACHE_TTL_MS=300000

# Stripe
DEMO_DISABLE_PAYMENT_GATE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=

# Resend
RESEND_API_KEY=
SKYLAR_TEAM_EMAIL=
# Verified sender (domain verified in Resend) for branded sign-in emails
RESEND_FROM_EMAIL=

# Platform console: comma-separated starting super admins. After that, any super admin can add or
# remove anyone at runtime from Platform -> Users (stored in Firestore platform_admins, which overrides this list).
PLATFORM_ADMIN_EMAILS=

# Contact address shown on the suspended/deleted account pages
SUPPORT_EMAIL=

# Secret the scheduler sends to /api/cron/purge-deleted (Vercel Cron sets it automatically)
CRON_SECRET=

# Sentry
SENTRY_DSN=
